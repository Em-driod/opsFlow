# ─────────────────────────────────────────────
# Morniy Backend — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to git
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB (get a free cluster at mongodb.com/atlas)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/morniy?retryWrites=true&w=majority

# JWT — generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# CORS — comma-separated list of allowed frontend origins in production
# Leave blank in development (localhost is always allowed)
ALLOWED_ORIGINS=https://app.morniy.com,https://morniy.com

# Frontend URL — used in email links (password reset, invoice links, etc.)
FRONTEND_URL=http://localhost:5173

# ── Email — Brevo ──────────────────────────────
# Sign up at brevo.com → Settings → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must be a verified sender in your Brevo account
BREVO_SENDER_EMAIL=noreply@morniy.com
BREVO_SENDER_NAME=Morniy

# ── AI — Google Gemini ─────────────────────────
# Get from aistudio.google.com → Get API key
GEMINI_API_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Payments — Paystack ────────────────────────
# Get from dashboard.paystack.com → Settings → API Keys
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# ── Google Sheets OAuth ────────────────────────
# Create credentials at console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:5000/api/export/google/callback

# ── Google Sign-In (Identity Services) ─────────
# Can reuse the same OAuth client ID as above, or create a separate one.
# Must match VITE_GOOGLE_CLIENT_ID in bizmanage-pro/.env.local
GOOGLE_LOGIN_CLIENT_ID=xxxxxxxxxxxxxx.apps.googleusercontent.com

# Logging: debug | info | warn | error | silent (default: info; error under tests)
LOG_LEVEL=info

# ── Bank alerts: forwarded emails (storefront payment matching) ─────────────
# Domain that receives forwarded bank alerts (set up Brevo inbound parsing for it).
# Each business gets a private address: pay-<token>@INBOUND_EMAIL_DOMAIN
INBOUND_EMAIL_DOMAIN=
# Shared secret the inbound webhook must present: POST /api/payments/webhooks/email?secret=...
INBOUND_EMAIL_SECRET=

# ── Bank alerts: linked bank feed (Mono) — optional ─────────────────────────
MONO_PUBLIC_KEY=
MONO_SECRET_KEY=
# Shared secret Mono sends with its webhooks
MONO_WEBHOOK_SECRET=

# ── Optional tuning ─────────────────────────────────────────────────────────
# Public base URL of this API (used for logo links in emails); Render sets RENDER_EXTERNAL_URL itself
PUBLIC_API_URL=
# Gemini models (defaults shown in code)
NLP_MODEL=
ADVISOR_MODEL=
# Max AI requests per business per hour (default 30)
AI_HOURLY_LIMIT_PER_BUSINESS=30
# Cron overrides: nightly summary, overdue sweep, recurring invoices
NIGHTLY_SUMMARY_CRON=
OVERDUE_SWEEP_CRON=
RECURRING_INVOICE_CRON=
